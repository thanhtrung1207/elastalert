pipeline {     
    agent any      

    environment {
        SOURCE_URL = ""
        SOURCE_BRANCH = ""
    }      

    stages {         
        stage('Parse JSON and Set Variables') {             
            steps {
                script {
                    //test
                    def jsonSlurper = new groovy.json.JsonSlurper()
                    def config = jsonSlurper.parseText(params.meta-data)

                    env.SOURCE_URL = config.source_code.url
                    env.SOURCE_BRANCH = config.source_code.branch

                    echo "Extracted Source URL: ${env.SOURCE_URL}"
                    echo "Extracted Source Branch: ${env.SOURCE_BRANCH}"
                }
            }         
        }     
    }     

    post {         
        always {             
            cleanWs()         
        }     
    } 
}
