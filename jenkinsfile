pipeline {
    agent any

    stages {
        stage('Parse JSON and Set Variables') {
            steps {
                script {
                    try {
                        def jsonSlurper = new groovy.json.JsonSlurper()
                        def jsonText = params."meta-data"?.trim() ?: '{}'
                        def config = jsonSlurper.parseText(jsonText)

                        env.SOURCE_URL = config?.source_code?.url ?: 'Not Provided'
                        env.SOURCE_BRANCH = config?.source_code?.branch ?: 'Not Provided'

                        echo "Extracted Source URL: ${env.SOURCE_URL}"
                        echo "Extracted Source Branch: ${env.SOURCE_BRANCH}"
                    } catch (Exception e) {
                        error "Failed to parse JSON: ${e.message}"
                    }
                }
            }
        }

        stage('Use Variables') {
            steps {
                script {
                    echo "Using Env Variables: ${env.SOURCE_URL}, ${env.SOURCE_BRANCH}"
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
