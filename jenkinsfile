pipeline {
    agent any

    stages {
        stage('Parse JSON and Set Variables') {
            steps {
                script {
                    try {
                        def jsonSlurper = new groovy.json.JsonSlurper()
                        def jsonText = params.get("meta-data", '{}')?.trim()
                        def config = jsonSlurper.parseText(jsonText)

                        // Extract values safely
                        env.SOURCE_URL = config?.source_code?.url?.trim() ?: ''
                        env.SOURCE_BRANCH = config?.source_code?.branch?.trim() ?: ''

                        // Validate required values
                        validateEnvVariables(env.SOURCE_URL, env.SOURCE_BRANCH)

                        echo "✅ Extracted Source URL: ${env.SOURCE_URL}"
                        echo "✅ Extracted Source Branch: ${env.SOURCE_BRANCH}"
                    } catch (Exception e) {
                        error "❌ Failed to parse JSON: ${e.message}"
                    }
                }
            }
        }

        stage('Use Variables') {
            steps {
                script {
                    echo "Using Env Variables: ${env.SOURCE_URL}, ${env.SOURCE_BRANCH}"
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
