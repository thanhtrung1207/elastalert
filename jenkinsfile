pipeline {
    agent any

    stages {
        stage('Parse JSON and Set Variables') {
            steps {
                script {
                    def jsonSlurper = new groovy.json.JsonSlurper()
                    def jsonText = params."meta-data" ?: '{}'
                    def config = jsonSlurper.parseText(jsonText)

                    def sourceUrl = config?.source_code?.url ?: 'Not Provided'
                    def sourceBranch = config?.source_code?.branch ?: 'Not Provided'

                    echo "Extracted Source URL: ${sourceUrl}"
                    echo "Extracted Source Branch: ${sourceBranch}"

                    // Dùng withEnv để cập nhật biến môi trường
                    withEnv(["SOURCE_URL=${sourceUrl}", "SOURCE_BRANCH=${sourceBranch}"]) {
                        echo "Updated Env Source URL: ${env.SOURCE_URL}"
                        echo "Updated Env Source Branch: ${env.SOURCE_BRANCH}"
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
