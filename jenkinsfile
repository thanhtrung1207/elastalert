pipeline {
    agent any

    stages {
        stage('Parse JSON') {
            steps {
                script {
                    try {
                        def jsonSlurper = new groovy.json.JsonSlurper()
                        def jsonText = params."meta-data"?.trim() ?: '{}'
                        def config = jsonSlurper.parseText(jsonText)

                        SOURCE_URL = config?.source_code?.url?.trim() ?: ''
                        SOURCE_BRANCH = config?.source_code?.branch?.trim() ?: ''

                        echo "Extracted Source URL: ${SOURCE_URL}"
                        echo "Extracted Source Branch: ${SOURCE_BRANCH}"
                    } catch (Exception e) {
                        error "Failed to parse JSON: ${e.message}"
                    }
                }
            }
        }

        stage('Validate Variables') {
            steps {
                script {
                    if (!SOURCE_URL || !SOURCE_BRANCH) {
                        error "ERROR: SOURCE_URL or SOURCE_BRANCH is empty!"
                    }
                    echo "Validation passed!"
                }
            }
        }

        stage('Use Variables') {
            steps {
                script {
                    echo "Using Env Variables: ${SOURCE_URL}, ${SOURCE_BRANCH}"
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
